# ========================================================
# PUB-AttendEye Environment Configuration
# ========================================================
# Replace placeholder values with your Supabase Project settings
# Found in: Supabase Dashboard -> Project Settings -> API
# ========================================================

# Public Supabase URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (safe for browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Optional: Service Role Key (NEVER expose to browser / client code! Server-side only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME="PUB AttendEye"
NEXT_PUBLIC_UNIVERSITY_NAME="Pundra University of Science & Technology"

# ========================================================
# Step 7: Python CV API Bridge (FastAPI service)
# ========================================================
# URL of the locally running Python FastAPI service.
# Default: http://127.0.0.1:8000 (used by src/lib/cv-api/client.ts)
PYTHON_CV_API_URL=http://127.0.0.1:8000

# JWT secret for server-side token verification (Python service only, NEVER expose to browser).
# Found in: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
# SUPABASE_JWT_SECRET=your-jwt-secret-here

# Python API environment: "development" (JWT bypass allowed) or "production" (JWT enforced)
# PYTHON_API_ENV=development

# Allowed frontend CORS origin for the Python service
# FRONTEND_ORIGIN=http://localhost:3000
